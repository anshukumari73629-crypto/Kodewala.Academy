package Com.Kodewala.loops1.copy;

import javax.print.attribute.standard.Chromaticity;

public class Driver11 {
	public static void main(String[] args) {
		String[] cities = {
				"Delhi","Banglore","Mumbai","Ranchi","Banglore",
				"Jaipur","Delhi","Banglore","Surat", "Banglore"
		};
		String searchCity = "Banglore";
		
		int firstposition = -1;
		int lastposition = -1;
		
		for(int i = 0; i < cities.length; i++) {
			
			String currentCity = cities[i];
					if (currentCity.equals(searchCity)) {
				if (firstposition == -1) {
					firstposition = i ;
				}
				lastposition = i;
			}
		}
		
		if (firstposition != -1) {
			System.out.println(searchCity +"found");
System.out.println("first position: + firstposition");	
System.out.println("last position "+ lastposition);
		}else {
			System.out.println(searchCity + "not found");
		}
				}
			}

